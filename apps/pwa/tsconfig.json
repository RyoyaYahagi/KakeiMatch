{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "paths": { "@/*": ["../../src/*"] }
  },
  "include": ["src/**/*.ts", "vite.config.ts", "cloudflare.config.ts"]
}
