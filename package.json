{
  "name": "kakeimatch",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm --dir apps/pwa dev",
    "build": "pnpm --dir apps/pwa build",
    "start": "pnpm --dir apps/pwa exec vite preview --host 127.0.0.1",
    "deploy": "pnpm --dir apps/pwa exec cf deploy --mode production-deploy",
    "deploy:preview": "pnpm --dir apps/pwa exec cf previews deploy kakeimatch-issue-39",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && pnpm --dir apps/pwa typecheck",
    "test": "vitest run --exclude src/lib/actual-gateway.live.test.ts",
    "legacy:test:live": "vitest run src/lib/actual-gateway.live.test.ts",
    "legacy:dev": "next dev --hostname 127.0.0.1",
    "legacy:build": "next build",
    "legacy:start": "next start --hostname 127.0.0.1",
    "legacy:eval:category": "node --conditions=react-server --import tsx eval/run-jev-category-eval.ts --live",
    "eval:reconciliation": "node --conditions=react-server --import tsx eval/run-reconciliation-eval.ts",
    "legacy:db:generate": "drizzle-kit generate",
    "legacy:db:migrate": "drizzle-kit migrate",
    "legacy:user:create": "tsx scripts/create-user.ts",
    "legacy:actual:link-user": "tsx scripts/link-actual-budget.ts",
    "legacy:actual:map-categories": "node --conditions=react-server --import tsx scripts/map-actual-categories.ts",
    "self-hosted:chatgpt": "tsx scripts/chatgpt-plan-server.ts"
  },
  "dependencies": {
    "@actual-app/api": "26.9.0",
    "csv-parse": "7.0.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@actual-app/cli": "26.9.0",
    "@better-auth/drizzle-adapter": "^1.7.6",
    "@better-auth/passkey": "1.7.6",
    "@eslint/eslintrc": "^3.3.1",
    "@google/genai": "^2.24.0",
    "@next/env": "^15.5.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "better-auth": "^1.7.6",
    "better-sqlite3": "^12.2.0",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.3",
    "fake-indexeddb": "^6.2.5",
    "jose": "6.2.12",
    "next": "^15.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
