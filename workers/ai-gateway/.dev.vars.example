# Local values for local Worker development in workers/ai-gateway. Copy to .dev.vars (ignored by Git) and keep them synthetic,
# except GEMINI_API_KEY when you deliberately use the real Gemini API.
# Generate each secret with: openssl rand -hex 32
AI_GATEWAY_AUTH_SECRET=<local-synthetic-secret>
CLOUD_ACCOUNT_ORIGIN=http://localhost:5173
GEMINI_API_KEY=<your-gemini-key-or-synthetic>
# Gemini is shared by receipt extraction and category classification.
GITHUB_ISSUES_TOKEN=<local-synthetic-token>
AI_EMERGENCY_STOP=false
AI_GUARDRAILS_JSON={}

# Generate independently with: openssl rand -base64 32
FEEDBACK_ENCRYPTION_KEY=<synthetic-32-byte-base64-key>
# Required for /admin and /api/admin/* (Cloudflare Access JWT + comma-separated email allowlist).
CF_ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
CF_ACCESS_AUD=<access-application-audience>
ADMIN_ACCESS_EMAILS=operator@example.test
