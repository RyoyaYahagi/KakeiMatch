{
  "name": "@kakeimatch/ai-gateway",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && cf build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "account:set-plan": "node ./scripts/account-set-plan.mjs",
    "account:invite": "node ./scripts/account-invite.mjs invite",
    "account:recover": "node ./scripts/account-invite.mjs recover"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.0",
    "@types/node": "22.18.6",
    "cf": "1.0.0-beta.5",
    "miniflare": "4.20260730.0",
    "typescript": "5.9.2",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.6",
    "better-auth": "1.7.6"
  },
  "overrides": {
    "sharp": "0.35.5",
    "undici": "7.29.1",
    "source-map-js": "1.2.2"
  }
}
