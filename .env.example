# Public application address. Compose binds its port to localhost only.
APP_URL=http://localhost:3002
APP_TIME_ZONE=Asia/Tokyo
PORT=3002

# Local default. In Docker Compose this is set to /app/data/kakeimatch.db.
DATABASE_PATH=./data/kakeimatch.db

# Required for Better Auth. Generate a unique value with: openssl rand -base64 32
# Set this before starting the app; never reuse the example value in production.
AUTH_SECRET=

# Actual Budget server. The web UI host port is bound to localhost by Compose.
# For containers in this Compose project, the default URL uses its private network.
ACTUAL_SERVER_URL=http://actual:5006
# Used by the KakeiMatch server only. Set this to the password configured in Actual.
ACTUAL_SERVER_PASSWORD=
# KakeiMatch CLI client cache; never point this at the Actual Server /data volume.
ACTUAL_CLI_DATA_DIR=./data/actual-cli
# Actual server data directory inside its container (backed by the actual-data volume).
ACTUAL_DATA_DIR=/data
# Optional host port for administrator access to the Actual UI (localhost only).
ACTUAL_HOST_PORT=5006
