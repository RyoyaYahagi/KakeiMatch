# KakeiMatch
# Copy to .env.local or configure in the deployment environment.
# Never commit real secrets.

# Application
APP_BASE_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-random-secret

# KakeiMatch database
DATABASE_URL=

# Receipt storage on the self-hosted Linux server (used in a later phase)
RECEIPT_STORAGE_DIR=

# Actual Budget
ACTUAL_SERVER_URL=http://actual-server:5006

# Prefer a session token or Docker secret where practical.
# Configure either the password or session token according to the adopted setup.
ACTUAL_PASSWORD=
ACTUAL_SESSION_TOKEN=

# Local cache/data directory used by the Actual CLI/API client.
ACTUAL_DATA_DIR=/var/lib/kakeimatch/actual-cli

# Gemini (Phase 3)
GEMINI_API_KEY=

# Jev (Phase 4)
# Final integration variable names should be confirmed against the provider used.
JEV_API_URL=
JEV_API_KEY=
