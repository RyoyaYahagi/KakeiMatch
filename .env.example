# Public application address. Compose binds its port to localhost only.
APP_URL=http://localhost:3002
PORT=3002

# Local default. In Docker Compose this is set to /app/data/kakeimatch.db.
DATABASE_PATH=./data/kakeimatch.db

# Required for Better Auth. Generate a unique value with: openssl rand -base64 32
# Set this before starting the app; never reuse the example value in production.
AUTH_SECRET=
